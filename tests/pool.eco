/**
 * The pool against a scripted server that takes any number of clients, each on a thread of its
 * own, and answers the few commands a pool sends: logins, pings, BEGIN, ROLLBACK, small queries.
 * What the server saw is counted, so a test can tell a reused connection from a new one.
 */

use std::thread;
use std::time;
use pgsql::protocol::{QUERY, SYNC, TERMINATE, COMMAND_COMPLETE};

internal struct Seen
{
    internal usize $logins = 0;
    internal usize $rollbacks = 0;
    internal usize $quits = 0;
    internal usize $pings = 0;
}

#[atomic]
internal class Many
{
    internal tcp::Listener $l;
    internal thread::mutex<Seen> $seen;

    internal constructor()
    {
        tcp::Listener $l = guard tcp::Listener::bind(tcp::Address(loopback: 0)) else ($e) {
            die("listen: {$e}");
        }
        $this->l = $l;
        $this->seen = thread::mutex<Seen>(Seen());
    }

    internal function seen() : Seen
    {
        thread::locked<Seen> $s = $this->seen->lock();
        return $s->value;
    }

    internal const function pool(pgsql::PoolOptions $limits) : pgsql::Pool
    {
        pgsql::Options $o = pgsql::Options($user: 'app', $password: 'secret');
        $o->port = $this->l->local->port;
        $o->connectTimeout = time::duration::secs(5);
        return pgsql::Pool($o, $limits);
    }

    /**
     * Accept clients until the listener closes, each served on a detached thread.
     */
    internal function start() : void
    {
        Many $me = $this;
        thread::handle $h = guard thread::spawn(function() : void {
            while (true) {
                result<tcp::Stream?, tcp::Error> $got = $me->l->accept(tcp::Deadline(ms: 200));
                if ($got->failed()) {
                    return;
                }
                tcp::Stream? $maybe = $got->unwrap();
                if ($maybe == null) {
                    continue;
                }
                tcp::Stream $s = guard $maybe;
                thread::handle $one = guard thread::spawn(function() : void {
                    $me->serve(Wire($s, $me->l));
                }) else ($e) {
                    die($e->message());
                }
                $one->detach();
            }
        }) else ($e) {
            die($e->message());
        }
        $h->detach();
    }

    internal function serve(Wire $w) : void
    {
        $w->welcome();
        {
            thread::locked<Seen> $s = $this->seen->lock();
            $s->value->logins = $s->value->logins + 1;
        }
        uint8 $status = 73;
        while (true) {
            Msg $m = guard $w->tryRecv(10000) else {
                return;
            }
            if ($m->type == TERMINATE) {
                thread::locked<Seen> $s = $this->seen->lock();
                $s->value->quits = $s->value->quits + 1;
                return;
            }
            if ($m->type == SYNC) {
                {
                    thread::locked<Seen> $s = $this->seen->lock();
                    $s->value->pings = $s->value->pings + 1;
                }
                $w->ready($status);
                continue;
            }
            if ($m->type == QUERY) {
                if ($m->body->starts('BEGIN')) {
                    $status = 84;
                    $w->send(COMMAND_COMPLETE, commandComplete('BEGIN'));
                } else if ($m->body->starts('ROLLBACK')) {
                    $status = 73;
                    {
                        thread::locked<Seen> $s = $this->seen->lock();
                        $s->value->rollbacks = $s->value->rollbacks + 1;
                    }
                    $w->send(COMMAND_COMPLETE, commandComplete('ROLLBACK'));
                } else if ($m->body->starts('COMMIT')) {
                    $status = 73;
                    $w->send(COMMAND_COMPLETE, commandComplete('COMMIT'));
                } else if ($m->body->starts('HANGUP')) {
                    // answered, then the server goes away while the connection sits idle
                    $w->send(COMMAND_COMPLETE, commandComplete('UPDATE 1'));
                    $w->ready($status);
                    $w->s->close();
                    return;
                } else if ($m->body->starts('FAIL')) {
                    $w->error('22012', 'division by zero');
                    if ($status == 84) {
                        $status = 69;
                    }
                } else {
                    $w->send(COMMAND_COMPLETE, commandComplete('UPDATE 1'));
                }
                $w->ready($status);
            }
        }
    }
}

internal function limits(usize $max, int64 $acquireMs) : pgsql::PoolOptions
{
    pgsql::PoolOptions $p = pgsql::PoolOptions();
    $p->max = $max;
    $p->acquireTimeout = time::duration::millis($acquireMs);
    return $p;
}

test the_pool_reuses_an_idle_connection
{
    Many $m = Many();
    $m->start();
    pgsql::Pool $p = $m->pool(limits(2, 2000));
    did($p->exec('UPDATE t SET a = 1'));
    did($p->exec('UPDATE t SET a = 2'));
    assert($m->seen()->logins == 1);
    assert($p->open() == 1);
    assert($p->idle() == 1);
    $p->close();
    thread::sleep(100);
    assert($m->seen()->quits == 1);
    $m->l->close();
}

test a_full_pool_makes_the_next_borrower_wait_then_gives_up
{
    Many $m = Many();
    $m->start();
    pgsql::Pool $p = $m->pool(limits(1, 300));
    pgsql::Lease $held = guard $p->acquire() else ($e) {
        die("{$e}");
    }
    time::instant $t = time::instant::now();
    assert($p->acquire()->failure()->name() == 'exhausted');
    assert($t->elapsed()->as_millis() >= 250);
    // a waiter gets the connection given back
    pgsql::Pool $shared = $p;
    thread::handle $h = guard thread::spawn(function() : void {
        thread::sleep(100);
        $held->release();
    }) else ($e) {
        die($e->message());
    }
    pgsql::Lease $next = guard $shared->acquire(by: tcp::Deadline(ms: 3000)) else ($e) {
        die("{$e}");
    }
    $h->join();
    assert($m->seen()->logins == 1);
    $next->release();
    $p->close();
    $m->l->close();
}

test a_lease_given_back_in_a_transaction_is_rolled_back
{
    Many $m = Many();
    $m->start();
    pgsql::Pool $p = $m->pool(limits(1, 2000));
    {
        pgsql::Lease $l = guard $p->acquire() else ($e) {
            die("{$e}");
        }
        did($l->db()->exec('BEGIN'));
        assert(failsExec($l->db()->exec('FAIL'))->is(.divisionByZero));
        assert($l->db()->inTransaction());
    }
    assert($m->seen()->rollbacks == 1);
    pgsql::Lease $again = guard $p->acquire() else ($e) {
        die("{$e}");
    }
    assert(!$again->db()->inTransaction());
    $again->release();
    // a transaction through the pool commits, and rolls back on error
    status<pgsql::Error> $t = $p->transaction(function(pgsql::Connection $c) : status<pgsql::Error> {
        guard $c->exec('FAIL') else ($e) {
            return .error($e);
        }
        return .ok;
    });
    assert($t->failure()->is(.divisionByZero));
    assert($m->seen()->rollbacks == 2);
    $p->close();
    $m->l->close();
}

test a_closed_pool_lends_nothing
{
    Many $m = Many();
    $m->start();
    pgsql::Pool $p = $m->pool(limits(2, 500));
    $p->close();
    assert($p->acquire()->failure()->name() == 'closed');
    $m->l->close();
}

test surplus_idle_connections_are_closed_on_return
{
    Many $m = Many();
    $m->start();
    pgsql::PoolOptions $o = limits(3, 2000);
    $o->maxIdle = 1;
    pgsql::Pool $p = $m->pool($o);
    {
        pgsql::Lease $a = guard $p->acquire() else ($e) {
            die("{$e}");
        }
        pgsql::Lease $b = guard $p->acquire() else ($e) {
            die("{$e}");
        }
        assert($p->open() == 2);
        $a->release();
        // released twice, given back once
        $a->release();
        assert($p->idle() == 1);
    }
    assert($p->open() == 1);
    assert($p->idle() == 1);
    thread::sleep(100);
    assert($m->seen()->quits == 1);
    $p->close();
    $m->l->close();
}

test a_connection_past_its_lifetime_is_closed_when_it_comes_back
{
    Many $m = Many();
    $m->start();
    pgsql::PoolOptions $o = limits(2, 2000);
    $o->maxLifetime = time::duration::millis(50);
    pgsql::Pool $p = $m->pool($o);
    {
        pgsql::Lease $l = guard $p->acquire() else ($e) {
            die("{$e}");
        }
        thread::sleep(100);
    }
    assert($p->open() == 0);
    assert($p->idle() == 0);
    did($p->exec('UPDATE t SET a = 1'));
    assert($m->seen()->logins == 2);
    $p->close();
    $m->l->close();
}

test an_idle_connection_past_its_timeout_is_not_lent
{
    Many $m = Many();
    $m->start();
    pgsql::PoolOptions $o = limits(2, 2000);
    $o->idleTimeout = time::duration::millis(50);
    pgsql::Pool $p = $m->pool($o);
    did($p->exec('UPDATE t SET a = 1'));
    thread::sleep(100);
    did($p->exec('UPDATE t SET a = 2'));
    assert($m->seen()->logins == 2);
    assert($p->open() == 1);
    thread::sleep(100);
    assert($m->seen()->quits == 1);
    $p->close();
    $m->l->close();
}

test a_connection_idle_a_while_is_pinged_and_replaced_when_gone
{
    Many $m = Many();
    $m->start();
    pgsql::PoolOptions $o = limits(1, 2000);
    $o->pingAfterIdle = time::duration::millis(20);
    pgsql::Pool $p = $m->pool($o);
    did($p->exec('UPDATE t SET a = 1'));
    // lent again at once: no ping
    did($p->exec('UPDATE t SET a = 2'));
    assert($m->seen()->pings == 0);
    thread::sleep(60);
    did($p->exec('UPDATE t SET a = 3'));
    assert($m->seen()->pings == 1);
    assert($m->seen()->logins == 1);
    // the server drops the connection while it is idle: the ping finds out, not the caller
    did($p->exec('HANGUP'));
    thread::sleep(60);
    did($p->exec('UPDATE t SET a = 4'));
    assert($m->seen()->logins == 2);
    assert($p->open() == 1);
    $p->close();
    $m->l->close();
}

test a_pool_transaction_hands_back_its_value
{
    Many $m = Many();
    $m->start();
    pgsql::Pool $p = $m->pool(limits(1, 2000));
    result<uint64, pgsql::Error> $n = $p->transaction<uint64>(function(pgsql::Connection $c) : result<uint64, pgsql::Error> {
        pgsql::Outcome $o = guard $c->exec('UPDATE t SET a = 1') else ($e) {
            return .error($e);
        }
        return .ok($o->affectedRows);
    });
    assert($n->or(0) == 1);
    assert($m->seen()->rollbacks == 0);
    // given back idle, outside a transaction
    assert($p->idle() == 1);
    pgsql::Lease $l = guard $p->acquire() else ($e) {
        die("{$e}");
    }
    assert(!$l->db()->inTransaction());
    $l->release();
    $p->close();
    $m->l->close();
}
